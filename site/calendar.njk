---
layout: base.njk
title: Calendar
permalink: /calendar/
---
<div class="page-banner">
  <h1>Events &amp; Calendar</h1>
  <p>{{ site.schoolYear }} School Year</p>
</div>

<section class="section">
  <h2>🌵 {{ site.schoolYear }} PTSA Calendar 🌵</h2>
  <p>
    Stay connected with everything happening at Saguaro Creek! Explore upcoming PTSA events, family
    activities, school spirit days, fundraisers, and community gatherings throughout the
    {{ site.schoolYear }} school year. Check back often for updated details, flyers, volunteer
    opportunities, and important event information.
  </p>
</section>

<section class="section">
  <h2>Upcoming Events</h2>
  {% set sheetOrManual = fetched.events | preferItems(manual.events) %}
  {% set events = [sheetOrManual, fetched.gcalEvents.items] | upcomingEvents %}
  {% if events.length %}
  <ul class="event-list">
    {% for e in events %}
    <li class="event-card">
      <div class="event-date" aria-hidden="true">
        <span class="event-mon">{{ e.date | mon }}</span>
        <span class="event-day">{{ e.date | dayNum }}{% if e.endDate %}–{{ e.endDate | dayNum }}{% endif %}</span>
      </div>
      <div class="event-body">
        <h3>{{ e.title }}</h3>
        <p class="event-meta">
          {{ e.date | readableDate }}{% if e.endDate %} – {{ e.endDate | readableDate }}{% endif %}
          {% if e.time %} · 🕐 {{ e.time }}{% endif %}
        </p>
        {% if e.location %}<p class="event-meta">📍 {{ e.location }}</p>{% endif %}
        {% if e.details %}<p>{{ e.details }}</p>{% endif %}
        {% if e.link %}<p><a href="{{ e.link }}">More info ↗</a></p>{% endif %}
        {% if e.image %}<p><img class="event-flyer" src="{{ e.image }}" alt="Flyer for {{ e.title }}"></p>{% endif %}
      </div>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p>No upcoming events posted yet — check back soon!</p>
  {% endif %}
  <p>
    Follow <a href="{{ site.facebook }}">Saguaro Creek PTSA on Facebook</a> for information about
    past events!
  </p>
</section>
