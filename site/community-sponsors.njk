---
layout: base.njk
title: Community Sponsors
permalink: /community-sponsors/
---
<div class="page-banner">
  <h1>Thank You, Sponsors!</h1>
  <p>Your support makes a difference for our Sidewinders.</p>
</div>

<section class="section">
  <p>
    <strong>A school is only as strong as the community behind it</strong> — and thanks to our
    incredible sponsors, we’re building something truly special! Your generous donations are what
    make the PTSA’s vision come to life. We couldn’t do it without you, and we’re beyond grateful
    for your support in making our school an even better place for our students, staff, and families.
  </p>
  <p><strong>Thank you for being a part of our success!</strong></p>
  <div class="button-row">
    <a class="btn" href="/sponsor-us/">Become a sponsor</a>
  </div>
</section>

{% set sponsors = fetched.sponsors | preferItems(manual.sponsors) %}
{% for t in tiers.items %}
  {% set tierSponsors = sponsors | byTier(t.name) %}
  {% if tierSponsors.length %}
  <section class="section">
    <h2 class="tier-heading tier-{{ t.name | lower }}">{{ t.name }} Sponsors</h2>
    <div class="sponsor-grid">
      {% for s in tierSponsors %}
      <article class="sponsor-card">
        {% if s.logo %}<img class="sponsor-logo" src="{{ s.logo }}" alt="{{ s.name }} logo">{% endif %}
        <h3>{{ s.name }}</h3>
        <ul class="sponsor-facts">
          {% if s.locatedIn %}<li>📍 Located in: {{ s.locatedIn }}</li>{% endif %}
          {% if s.address %}<li>🏠 {{ s.address }}</li>{% endif %}
          {% if s.phone %}<li>📞 {{ s.phone }}</li>{% endif %}
          {% if s.website %}<li>🌐 <a href="{{ s.website }}">{{ s.website | replace("https://", "") | replace("http://", "") }}</a></li>{% endif %}
        </ul>
        <p class="fine-print">Thank you for supporting our students! 💚</p>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}
{% endfor %}
