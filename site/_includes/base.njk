<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="icon" href="/assets/img/logo.jpg">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body{% if activeTheme.name != "default" %} class="theme-{{ activeTheme.name }}"{% endif %}>
  <header class="topbar">
    <a class="brand" href="/">
      <img src="/assets/img/logo.jpg" alt="Saguaro Creek Sidewinders logo" class="brand-logo">
      <span class="brand-text">
        <strong>{{ site.name }}</strong>
        <small>{{ site.tagline }}</small>
      </span>
    </a>
  </header>
  <nav class="mainnav" aria-label="Main navigation">
    <a href="/">Home</a>
    <a href="/calendar/">Events</a>
    <a href="/volunteer/">Volunteer</a>
    <a href="/community-sponsors/">Sponsors</a>
    <a href="/about/">About</a>
    <a href="{{ site.store }}" class="nav-join">Join the PTSA ↗</a>
  </nav>
  {% if activeTheme.banner %}
  <div class="theme-banner">{{ activeTheme.banner }}</div>
  {% endif %}
  <main class="page">
    {{ content | safe }}
  </main>
  <footer class="footer">
    <h2>Get Connected!</h2>
    <p>
      ✉️ Email us at <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      &nbsp;·&nbsp;
      🌐 Follow <a href="{{ site.facebook }}">Saguaro Creek PTSA on Facebook</a>
    </p>
    <p class="footer-small">
      {{ site.school }} · Vail School District, Arizona ·
      <a href="{{ site.districtPage }}">School district PTA page</a> ·
      <a href="{{ site.givebacks }}">Membership &amp; store (Givebacks)</a>
    </p>
    <p class="footer-small">© {% year %} {{ site.name }} — a 501(c)(3) nonprofit. Site maintained by PTSA volunteers.</p>
  </footer>
  {% if site.goatcounter %}
  <script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  {% endif %}
</body>
</html>
